NODE_ENV=production
PORT=3003
LOG_LEVEL=info

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=payment
DATABASE_PASSWORD=payment
DATABASE_NAME=payment_db
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PAYMENT_EVENTS_EXCHANGE=payment.events
BOOKING_EVENTS_EXCHANGE=booking.events

# VNPay sandbox credentials — replace with your team's values
VNPAY_TMN_CODE=your-tmn-code-here
VNPAY_HASH_SECRET=your-hash-secret-here
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:8000/api/payments/vnpay-return
FRONTEND_URL=http://localhost:5173
