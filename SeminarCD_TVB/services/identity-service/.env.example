NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=identity
DATABASE_PASSWORD=identity
DATABASE_NAME=identity_db
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=false

# JWT - must match the secret Strapi uses today during the migration window
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=30d

# Migration source - path to the legacy SQLite file (read-only for F2.2 migration script)
SQLITE_MIGRATION_SOURCE=../../Travel_TVB_Server/.tmp/data.db
