# Content Service — Strapi 5 configuration
# Copy this to .env and fill in real values.

HOST=0.0.0.0
PORT=1337

# Admin panel secrets
APP_KEYS=change-me-key1,change-me-key2,change-me-key3,change-me-key4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
ENCRYPTION_KEY=change-me-encryption-key

# PostgreSQL (content_db)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=content_db
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# JWT (users-permissions plugin — kept for admin panel internals)
JWT_SECRET=change-me-jwt-secret
